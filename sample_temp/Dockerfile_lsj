FROM ultralytics/ultralytics:8.4.23-nvidia-arm64

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgomp1 \
    mosquitto \
    mosquitto-clients \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "PyYAML>=6.0" \
    "paho-mqtt>=2.0.0" \
    "aiohttp>=3.9.0" \
    "aiortc>=1.6.0"

RUN pip install --no-cache-dir \
    git+https://github.com/ultralytics/CLIP.git \
    ftfy \
    regex \
    tqdm

RUN groupadd -g 1004 scaleup && useradd -u 1004 -g 1004 -m scaleup
RUN chown -R scaleup:scaleup /app
USER scaleup


ENV PYTHONUNBUFFERED=1
